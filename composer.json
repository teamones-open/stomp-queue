{
  "name": "teamones/stomp-queue",
  "description": "Asynchronous STOMP queue client for webman, with AMQP topology declarations.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "php-amqplib/php-amqplib": "^3.7",
    "workerman/stomp": "^1.0",
    "workerman/workerman": "^4.1 || ^5.0"
  },
  "autoload": {
    "psr-4": {
      "Webman\\Stomp\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:integration": "php tests/integration.php start && php tests/integration-check.php"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-3.x": "3.0.x-dev"
    }
  }
}
